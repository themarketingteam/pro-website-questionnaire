# Copy to .env.staging and replace every placeholder outside Git.
PRO_DEPLOY_ENVIRONMENT=staging
BASE44_EXPECTED_APP_ID=<staging-app-id-from-secure-environment>
BASE44_PRODUCTION_APP_ID=<production-app-id-from-secure-environment>
BASE44_STAGING_APP_ID=<staging-app-id-from-secure-environment>
ALLOW_PRODUCTION_DEPLOY=false
EXPECTED_GIT_BRANCH=feature/durable-draft-recovery

# Browser-visible runtime configuration. Never place secrets in VITE_* values.
VITE_APP_ENVIRONMENT=staging
VITE_APP_BUILD_SHA=<staging-build-sha>
VITE_APP_BUILD_TIME=<staging-build-time-iso-8601>
VITE_PRO_DRAFT_V2_ENABLED=false
VITE_PRO_DRAFT_V2_KILL_SWITCH=true
VITE_PRO_DRAFT_PUBLIC_EMAIL_RECOVERY_ENABLED=false
VITE_PRO_DRAFT_EMAIL_OTP_ENABLED=false
VITE_PRO_DRAFT_MAGIC_LINK_ENABLED=false
VITE_PRO_DRAFT_DIAGNOSTICS_ENABLED=true
VITE_STAGING_BANNER_ENABLED=true

# Backend values are ordinary runtime configuration, not secrets.
PRO_DRAFT_ENVIRONMENT=staging
PRO_DRAFT_V2_SERVER_ENABLED=false
PRO_DRAFT_V2_KILL_SWITCH=true
PRO_DRAFT_PUBLIC_EMAIL_RECOVERY_ENABLED=false
PRO_DRAFT_EMAIL_OTP_ENABLED=false
PRO_DRAFT_MAGIC_LINK_ENABLED=false
PRO_DRAFT_EXTERNAL_SIDE_EFFECTS_MODE=disabled
PRO_DRAFT_DIAGNOSTICS_ENABLED=false
PRO_DRAFT_BUILD_SHA=<staging-build-sha>
