{
  "name": "backupProQuestionnaireRetention",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "daily_pro_questionnaire_retention_backup",
      "description": "Incrementally backs up retained questionnaire records and files to encrypted S3 storage.",
