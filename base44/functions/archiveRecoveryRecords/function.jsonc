{
  "name": "archiveRecoveryRecords",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "daily_recovery_record_archive",
      "description": "Archives submitted recovery records older than 365 days without permanently deleting data.",
      "function_args": {
        "policy_id": "recovery-retention-v1"
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "15 7 * * *"
    }
  ]
}
