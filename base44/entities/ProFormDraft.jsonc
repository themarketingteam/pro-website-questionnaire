{
  "name": "ProFormDraft",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Stable questionnaire session ID"
    },
    "business_name": {
      "type": "string",
      "description": "Business name associated with the draft"
    },
    "domain": {
      "type": "string",
      "description": "Business domain associated with the draft"
    },
    "user_id": {
      "type": "string",
      "description": "Client user ID if available"
    },
    "user_name": {
      "type": "string",
      "description": "Client user name if available"
    },
    "user_email": {
      "type": "string",
      "description": "Client user email if available"
    },
    "status": {
      "type": "string",
      "description": "Draft lifecycle status"
    },
    "current_question_id": {
      "type": "string",
      "description": "Currently active question ID"
    },
    "last_changed_question_id": {
      "type": "string",
      "description": "Last changed question ID"
    },
    "responses_json": {
      "type": "string",
      "description": "Serialized questionnaire responses"
    },
    "validation_status_json": {
      "type": "string",
      "description": "Serialized validation status map"
    },
    "touched_questions_json": {
      "type": "string",
      "description": "Serialized touched questions map"
    },
    "expanded_questions_json": {
      "type": "string",
      "description": "Serialized expanded questions map"
    },
    "metadata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload metadata"
    },
    "userdata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload userdata"
    },
    "mapped_payload_json": {
      "type": "string",
      "description": "JSON string of full mapped final-style questionnaire payload"
    },
    "draft_metadata_json": {
      "type": "string",
      "description": "Technical draft autosave metadata such as page path, source, and user agent"
    },
    "save_error": {
      "type": "string",
      "description": "Latest draft save error message"
    },
    "submit_error": {
      "type": "string",
      "description": "Latest submit error payload"
    },
    "submit_attempted_at": {
      "type": "string",
      "description": "When final submit was attempted"
    },
    "submitted_at": {
      "type": "string",
      "description": "When final submit succeeded"
    },
    "last_changed_at": {
      "type": "string",
      "description": "When the last answer changed"
    },
    "last_saved_at": {
      "type": "string",
      "description": "When the draft was last saved"
    },
    "final_submission_id": {
      "type": "string",
      "description": "Linked final submission ID"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Current AI repair lifecycle status for this draft (e.g. pending, running, completed, failed, skipped)"
    },
    "last_ai_repair_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent AI repair attempt for this draft"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "Serialized error details if the AI repair attempt for this draft failed"
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "Full JSON report returned by the pro_submission_repair_agent for this draft"
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "Serialized repaired payload produced by the pro_submission_repair_agent for this draft"
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the AI-repaired payload was accepted and used in a submission attempt for this draft"
    }
  },
  "required": [
    "session_id"
  ]
}