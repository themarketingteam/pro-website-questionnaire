{
  "name": "ProFormDraft",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Stable questionnaire session ID"
    },
    "access_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the anonymous draft capability; the token itself is never stored"
    },
    "access_version": {
      "type": "number",
      "default": 1,
      "description": "Version of the anonymous draft access contract"
    },
    "shared_access_token_hashes_json": {
      "type": "string",
      "description": "JSON array of SHA-256 hashes for administrator-created client resume links; plaintext credentials are never stored"
    },
    "shared_access_link_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator most recently created a client resume link"
    },
    "shared_access_link_created_by": {
      "type": "string",
      "description": "Audited administrator or recovery-grant actor that most recently created a client resume link"
    },
    "shared_access_link_generation_count": {
      "type": "number",
      "default": 0,
      "description": "Number of client resume links generated for this draft"
    },
    "history_baseline_json": {
      "type": "string",
      "description": "Server-side baseline used to deterministically replay append-only draft mutations"
    },
    "history_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When versioned server-side draft history was enabled"
    },
    "save_revision": {
      "type": "number",
      "default": 0,
      "description": "Latest materialized draft revision"
    },
    "latest_client_sequences_json": {
      "type": "string",
      "description": "Highest accepted sequence per anonymous client instance"
    },
    "progress_percent": {
      "type": "number",
      "default": 0,
      "description": "Questionnaire completion progress at the latest durable save"
    },
    "business_name": {
      "type": "string",
      "description": "Business name associated with the draft"
    },
    "domain": {
      "type": "string",
      "description": "Business domain associated with the draft"
    },
    "user_id": {
      "type": "string",
      "description": "Client user ID if available"
    },
    "user_name": {
      "type": "string",
      "description": "Client user name if available"
    },
    "user_email": {
      "type": "string",
      "description": "Client user email if available"
    },
    "status": {
      "type": "string",
      "description": "Draft lifecycle status"
    },
    "current_question_id": {
      "type": "string",
      "description": "Currently active question ID"
    },
    "last_changed_question_id": {
      "type": "string",
      "description": "Last changed question ID"
    },
    "responses_json": {
      "type": "string",
      "description": "Serialized questionnaire responses"
    },
    "validation_status_json": {
      "type": "string",
      "description": "Serialized validation status map"
    },
    "touched_questions_json": {
      "type": "string",
      "description": "Serialized touched questions map"
    },
    "expanded_questions_json": {
      "type": "string",
      "description": "Serialized expanded questions map"
    },
    "metadata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload metadata"
    },
    "userdata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload userdata"
    },
    "mapped_payload_json": {
      "type": "string",
      "description": "JSON string of full mapped final-style questionnaire payload"
    },
    "draft_metadata_json": {
      "type": "string",
      "description": "Technical draft autosave metadata such as page path, source, and user agent"
    },
    "save_error": {
      "type": "string",
      "description": "Latest draft save error message"
    },
    "submit_error": {
      "type": "string",
      "description": "Latest submit error payload"
    },
    "submit_attempted_at": {
      "type": "string",
      "description": "When final submit was attempted"
    },
    "submitted_at": {
      "type": "string",
      "description": "When final submit succeeded"
    },
    "last_changed_at": {
      "type": "string",
      "description": "When the last answer changed"
    },
    "last_saved_at": {
      "type": "string",
      "description": "When the draft was last saved"
    },
    "final_submission_id": {
      "type": "string",
      "description": "Linked final submission ID"
    },
    "intake_id": {
      "type": "string",
      "description": "Linked durable fallback intake ID when final submission creation did not complete"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Current AI repair lifecycle status for this draft (e.g. pending, running, completed, failed, skipped)"
    },
    "last_ai_repair_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent AI repair attempt for this draft"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "Serialized error details if the AI repair attempt for this draft failed"
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "Full JSON report returned by the pro_submission_repair_agent for this draft"
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "Serialized repaired payload produced by the pro_submission_repair_agent for this draft"
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the AI-repaired payload was accepted and used in a submission attempt for this draft"
    },
    "identity_resolution_status": {
      "type": "string",
      "description": "Latest identity-resolution state without changing the draft workflow status"
    },
    "identity_resolution_latest_attempt_id": {
      "type": "string",
      "description": "Latest ProFormIdentityResolutionAttempt record for this draft"
    },
    "identity_resolution_fingerprint": {
      "type": "string",
      "description": "Resolver-versioned fingerprint used for stale-write and duplicate-attempt protection"
    },
    "last_identity_resolution_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent non-diagnostic identity-resolution attempt"
    },
    "identity_resolution_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of non-diagnostic identity-resolution attempts"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this draft was moved out of the active recovery dataset"
    },
    "archive_reason": {
      "type": "string",
      "description": "Policy or administrator reason for archiving this draft"
    },
    "retention_policy_version": {
      "type": "string",
      "description": "Versioned retention policy applied to this draft"
    },
    "retention_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent meaningful activity used to calculate the minimum retention period"
    },
    "retention_until": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest date this record may leave the active recovery dataset"
    },
    "soft_deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator moved this draft to Deleted Records without erasing it"
    },
    "soft_deleted_by": {
      "type": "string",
      "description": "Audited administrator or recovery-grant actor that soft-deleted this draft"
    },
    "soft_delete_reason": {
      "type": "string",
      "description": "Administrator-supplied reason for soft deletion"
    },
    "retention_restore_source_id": {
      "type": "string",
      "description": "Original record ID when this draft was restored from an independent backup"
    }
  },
  "required": [
    "session_id"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": false
  }
}
