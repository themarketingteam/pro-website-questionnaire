{
  "name": "ProFormMigrationCheckpoint",
  "type": "object",
  "properties": {
    "migration_name": { "type": "string", "description": "Stable migration operation name" },
    "environment": { "type": "string", "description": "Exact environment authorized for this checkpoint" },
    "migration_version": { "type": "number", "description": "Positive migration contract version" },
    "batch_id": { "type": "string", "description": "Opaque migration batch identifier" },
    "mode": { "type": "string", "enum": ["dry_run", "apply", "rollback"], "description": "Current migration execution mode" },
    "entity_name": { "type": "string", "description": "Entity currently being processed" },
    "cursor": { "type": "string", "description": "Opaque current resumable cursor" },
    "records_scanned": { "type": "number", "description": "Count of records scanned" },
    "records_planned": { "type": "number", "description": "Count of safe updates planned" },
    "records_updated": { "type": "number", "description": "Count of records updated" },
    "records_skipped": { "type": "number", "description": "Count of records skipped" },
    "records_failed": { "type": "number", "description": "Count of records that failed processing" },
    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed", "cancelled"], "description": "Checkpoint lifecycle status" },
    "phase": { "type": "string", "description": "Current bounded migration phase" },
    "draft_cursor": { "type": "string", "description": "Opaque resumable draft cursor" },
    "event_cursor": { "type": "string", "description": "Opaque resumable event cursor" },
    "apply_draft_cursor": { "type": "string", "description": "Opaque resumable draft apply cursor" },
    "apply_event_cursor": { "type": "string", "description": "Opaque resumable event apply cursor" },
    "analyzed_count": { "type": "number", "description": "Count of records analyzed" },
    "applied_count": { "type": "number", "description": "Count of records changed" },
    "skipped_count": { "type": "number", "description": "Count of records safely skipped" },
    "manual_review_count": { "type": "number", "description": "Count requiring manual review" },
    "dry_run_report_hash": { "type": "string", "description": "SHA-256 hash of the approved safe dry-run report" },
    "retention_cutoff": { "type": "string", "format": "date-time", "description": "Authoritative server-time cutoff fixed for a retention batch" },
    "retention_policy_version": { "type": "number", "description": "Retention policy version used for analysis and apply" },
    "retention_report_hash": { "type": "string", "description": "SHA-256 hash of the approved safe retention report" },
    "retention_apply_index": { "type": "number", "description": "Next approved safe report entry to process during resumable retention apply" },
    "approved_record_count": { "type": "number", "description": "Maximum record count authorized by the dry run" },
    "apply_processed_count": { "type": "number", "description": "Count of records examined during bounded apply work" },
    "apply_token_hash": { "type": "string", "description": "One-way hash of the current one-time apply token" },
    "apply_token_used_at": { "type": "string", "format": "date-time", "description": "Server timestamp when the apply token was consumed" },
    "retention_apply_token_hash": { "type": "string", "description": "One-way hash of the one-time retention apply token" },
    "retention_apply_token_used_at": { "type": "string", "format": "date-time", "description": "Server timestamp when the retention apply token was consumed" },
    "requested_by_grant_token_hash": { "type": "string", "description": "One-way hash of the authorizing admin grant token identifier" },
    "last_record_id": { "type": "string", "description": "Last safely processed record identifier" },
    "last_record_fingerprint": { "type": "string", "description": "Fingerprint observed for the last processed record" },
    "started_at": { "type": "string", "format": "date-time", "description": "Server timestamp when processing started" },
    "updated_at": { "type": "string", "format": "date-time", "description": "Server timestamp when checkpoint progress last changed" },
    "completed_at": { "type": "string", "format": "date-time", "description": "Server timestamp when processing completed" },
    "last_error_code": { "type": "string", "description": "Safe machine-readable error code without record content" },
    "report_json": { "type": "string", "description": "Serialized safe summary containing no answers, email, grant, or full record" },
    "test_run_id": { "type": "string", "description": "Synthetic test-run identifier" },
    "migration_direction": { "type": "string", "description": "Forward or limited rollback direction" },
    "source_content_hash": { "type": "string", "description": "Optional safe aggregate source fingerprint" },
    "migrated_at": { "type": "string", "format": "date-time", "description": "Server timestamp for latest migration page" },
    "operation_mode": { "type": "string", "enum": ["initial_full", "incremental_delta", "final_freeze_delta", "late_write_reconciliation", "reverse_full", "reverse_delta", "integrity_verify", "file_reference_audit"], "description": "Explicit migration operation mode" },
    "active_direction": { "type": "string", "enum": ["blue_to_green", "green_to_blue"], "description": "Direction currently protected by the lease" },
    "lease_id": { "type": "string", "description": "Opaque direction lease identifier" },
    "lease_owner": { "type": "string", "description": "Opaque operator or runner identity" },
    "lease_acquired_at": { "type": "string", "format": "date-time", "description": "Server lease acquisition timestamp" },
    "lease_expires_at": { "type": "string", "format": "date-time", "description": "Bounded server lease expiry" },
    "lease_heartbeat_at": { "type": "string", "format": "date-time", "description": "Latest server lease heartbeat" },
    "source_app_id": { "type": "string", "description": "Protected source application identity" },
    "destination_app_id": { "type": "string", "description": "Protected destination application identity" },
    "app_pair_key": { "type": "string", "description": "Direction-independent application-pair fingerprint" },
    "force_release_audit_json": { "type": "string", "description": "Safe force-release fingerprints and reason; never a raw grant" },
    "snapshot_cutoff": { "type": "string", "format": "date-time", "description": "Fixed server snapshot cutoff for the current pass" },
    "last_logical_updated_at": { "type": "string", "format": "date-time", "description": "Last source server updated_date in the logical tuple" },
    "last_source_record_id": { "type": "string", "description": "Stable source ID tie-breaker for the high-water tuple" },
    "overlap_started_at": { "type": "string", "format": "date-time", "description": "Inclusive delta overlap boundary" },
    "page_offset": { "type": "number", "description": "Fallback sorted-page offset" },
    "pass_number": { "type": "number", "description": "Current verification or reconciliation pass" },
    "source_count_observed": { "type": "number", "description": "Source count observed for pagination-shift detection" },
    "last_bundle_hash": { "type": "string", "description": "Hash of the latest signed bundle" },
    "quiet_pass_count": { "type": "number", "description": "Consecutive zero-change verification passes" },
    "freeze_started_at": { "type": "string", "format": "date-time", "description": "Server time when blue freeze began" },
    "domain_switched_at": { "type": "string", "format": "date-time", "description": "Server time when the domain moved" },
    "blue_maintenance_started_at": { "type": "string", "format": "date-time", "description": "Server time when blue entered maintenance" },
    "reconciliation_ended_at": { "type": "string", "format": "date-time", "description": "Server time when late-write reconciliation ended" }
  },
  "required": ["migration_name", "environment", "migration_version", "batch_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
