{
  "type": "object",
  "name": "ProFormDraftRevision",
  "properties": {
    "draft_id": {
      "type": "string",
      "description": "Linked ProFormDraft record ID"
    },
    "session_id": {
      "type": "string",
      "description": "Stable non-sensitive questionnaire session ID"
    },
    "mutation_id": {
      "type": "string",
      "description": "Idempotency key generated by the questionnaire client"
    },
    "client_instance_id": {
      "type": "string",
      "description": "Anonymous browser-instance identifier used only for save ordering"
    },
    "client_sequence": {
      "type": "number",
      "description": "Monotonic save sequence within a client instance"
    },
    "base_revision": {
      "type": "number",
      "description": "Materialized revision visible to the client before this mutation"
    },
    "changed_keys_json": {
      "type": "string",
      "description": "Answer keys explicitly set by this mutation"
    },
    "deleted_keys_json": {
      "type": "string",
      "description": "Answer keys explicitly deleted by this mutation"
    },
    "changes_json": {
      "type": "string",
      "description": "Sanitized answer and questionnaire-state changes for deterministic replay"
    },
    "result_snapshot_json": {
      "type": "string",
      "description": "Sanitized post-mutation snapshot retained for administrator recovery"
    },
    "status": {
      "type": "string",
      "description": "Requested lifecycle status for this save"
    },
    "server_received_at": {
      "type": "string",
      "description": "Authoritative server receipt time",
      "format": "date-time"
    },
    "client_changed_at": {
      "type": "string",
      "description": "Bounded client change timestamp for diagnostics",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "Save trigger such as autosave, final_barrier, or explicit_clear"
    }
  },
  "required": [
    "draft_id",
    "session_id",
    "mutation_id",
    "client_instance_id",
    "client_sequence",
    "server_received_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}