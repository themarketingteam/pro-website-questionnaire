{
  "name": "ProFormOperationalEvent",
  "type": "object",
  "description": "PII-free operational telemetry written only by validated backend functions.",
  "properties": {
    "event_id": {"type": "string"},
    "event_type": {"type": "string"},
    "environment": {"type": "string"},
    "severity": {"type": "string", "enum": ["debug", "info", "warning", "error", "critical"]},
    "request_id": {"type": "string"},
    "draft_fingerprint": {"type": "string"},
    "session_fingerprint": {"type": "string"},
    "operation": {"type": "string"},
    "status": {"type": "string"},
    "error_code": {"type": "string"},
    "retryable": {"type": "boolean"},
    "latency_ms": {"type": "number"},
    "retry_count": {"type": "number"},
    "client_revision": {"type": "number"},
    "server_revision": {"type": "number"},
    "storage_mode": {"type": "string"},
    "browser_family": {"type": "string"},
    "device_class": {"type": "string"},
    "app_build_sha": {"type": "string"},
    "function_version": {"type": "string"},
    "source_tab_fingerprint": {"type": "string"},
    "test_run_id": {"type": "string"},
    "metadata_json": {"type": "string", "description": "Allowlisted safe structured metadata only; never answers, identifiers, PII, credentials, or tokens."},
    "created_at_server": {"type": "string", "format": "date-time"},
    "retention_expires_at": {"type": "string", "format": "date-time"},
    "retention_hold": {"type": "boolean", "default": false},
    "source_app_id": {"type": "string"},
    "source_entity": {"type": "string"},
    "source_record_id": {"type": "string"},
    "source_created_date": {"type": "string", "format": "date-time"},
    "source_updated_date": {"type": "string", "format": "date-time"},
    "migration_batch_id": {"type": "string"},
    "migration_direction": {"type": "string"},
    "migrated_at": {"type": "string", "format": "date-time"},
    "source_content_hash": {"type": "string"},
    "migration_version": {"type": "number"}
  },
  "required": ["event_id", "event_type", "environment"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
