{
  "name": "ProFormSubmissionIntake",
  "type": "object",
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "business_name": {
      "type": "string"
    },
    "business_domain": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "received_intake",
        "retry_pending",
        "retry_success",
        "retry_failed",
        "abandoned"
      ],
      "default": "received_intake"
    },
    "intake_reason": {
      "type": "string"
    },
    "primary_failure_kind": {
      "type": "string"
    },
    "fallback_failure_kind": {
      "type": "string"
    },
    "primary_error_json": {
      "type": "string"
    },
    "fallback_error_json": {
      "type": "string"
    },
    "retry_error_json": {
      "type": "string"
    },
    "transformed_payload_json": {
      "type": "string"
    },
    "raw_responses_json": {
      "type": "string"
    },
    "diagnostics_json": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at_client": {
      "type": "string"
    },
    "created_at_server": {
      "type": "string"
    },
    "last_retry_at": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "linked_submission_id": {
      "type": "string"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Current AI repair lifecycle status (e.g. pending, running, completed, failed, skipped)"
    },
    "ai_repair_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of AI repair attempts made for this intake record"
    },
    "last_ai_repair_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent AI repair attempt"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "Serialized error details if the AI repair attempt itself failed"
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "Full JSON report returned by the pro_submission_repair_agent (decision, diagnosis, changed_paths, warnings, etc.)"
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "Serialized repaired payload produced by the pro_submission_repair_agent"
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the AI-repaired payload was accepted and used in a submission attempt"
    },
    "ai_repair_retry_attempted": {
      "type": "boolean",
      "default": false,
      "description": "True if a submission retry was attempted using the AI-repaired payload"
    },
    "ai_repair_retry_result_json": {
      "type": "string",
      "description": "Serialized result of the submission retry that used the AI-repaired payload"
    },
    "ai_repair_source": {
      "type": "string",
      "description": "Source context that triggered the AI repair (e.g. admin_manual, scheduled_job, retry_hook)"
    }
  },
  "required": [
    "questionnaire_session_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}