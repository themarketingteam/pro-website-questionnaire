{
  "name": "ProFormSubmissionIntake",
  "type": "object",
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "business_name": {
      "type": "string"
    },
    "business_domain": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "received_intake",
        "retry_pending",
        "retry_success",
        "retry_failed",
        "abandoned"
      ],
      "default": "received_intake"
    },
    "intake_reason": {
      "type": "string"
    },
    "primary_failure_kind": {
      "type": "string"
    },
    "fallback_failure_kind": {
      "type": "string"
    },
    "primary_error_json": {
      "type": "string"
    },
    "fallback_error_json": {
      "type": "string"
    },
    "retry_error_json": {
      "type": "string"
    },
    "transformed_payload_json": {
      "type": "string"
    },
    "raw_responses_json": {
      "type": "string"
    },
    "diagnostics_json": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at_client": {
      "type": "string"
    },
    "created_at_server": {
      "type": "string"
    },
    "last_retry_at": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "linked_submission_id": {
      "type": "string"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Current AI repair lifecycle status (e.g. pending, running, completed, failed, skipped)"
    },
    "ai_repair_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of AI repair attempts made for this intake record"
    },
    "last_ai_repair_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent AI repair attempt"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "Serialized error details if the AI repair attempt itself failed"
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "Full JSON report returned by the pro_submission_repair_agent (decision, diagnosis, changed_paths, warnings, etc.)"
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "Serialized repaired payload produced by the pro_submission_repair_agent"
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the AI-repaired payload was accepted and used in a submission attempt"
    },
    "ai_repair_retry_attempted": {
      "type": "boolean",
      "default": false,
      "description": "True if a submission retry was attempted using the AI-repaired payload"
    },
    "ai_repair_retry_result_json": {
      "type": "string",
      "description": "Serialized result of the submission retry that used the AI-repaired payload"
    },
    "ai_repair_source": {
      "type": "string",
      "description": "Source context that triggered the AI repair (e.g. admin_manual, scheduled_job, retry_hook)"
    },
    "source_draft_id": {
      "type": "string",
      "description": "Identifier of the source draft associated with this intake record.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "canonical_state_hash": {
      "type": "string",
      "description": "Stable hash of the canonical questionnaire state associated with this intake.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "submitted_state_hash": {
      "type": "string",
      "description": "Stable hash of the immutable state used by the intake submission attempt.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "environment": {
      "type": "string",
      "description": "Environment classification assigned by trusted backend or migration code.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "test_run_id": {
      "type": "string",
      "description": "Synthetic test-run identifier used to exclude test records from production migration.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "zapier_suppressed": {
      "type": "boolean",
      "default": false,
      "description": "Whether external Zapier delivery was intentionally suppressed without marking it sent.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "zapier_redirected": {
      "type": "boolean",
      "default": false,
      "description": "Whether Zapier delivery was redirected to an approved non-production destination.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "zapier_status": {
      "type": "string",
      "description": "Safe Zapier delivery status without destination, response body, or payload data.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_app_id": {
      "type": "string",
      "description": "Internal Base44 application identifier of the source record.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_entity": {
      "type": "string",
      "description": "Source entity name used in the deterministic migration identity.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_record_id": {
      "type": "string",
      "description": "Source record identifier used in the deterministic migration identity.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp reported by the source platform.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Update timestamp reported by the source platform.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "migration_batch_id": {
      "type": "string",
      "description": "Identifier of the migration batch that last wrote this record.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "migration_direction": {
      "type": "string",
      "description": "Forward or reverse migration direction for the latest migrated representation.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative timestamp when the migration runner wrote this representation.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "source_content_hash": {
      "type": "string",
      "description": "Stable hash of migration-relevant source content excluding destination bookkeeping.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "migration_version": {
      "type": "number",
      "description": "Version of the migration transform applied to this record.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    }
  },
  "required": [
    "questionnaire_session_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
