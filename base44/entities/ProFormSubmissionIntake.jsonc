{
  "name": "ProFormSubmissionIntake",
  "type": "object",
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "business_name": {
      "type": "string"
    },
    "business_domain": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "received_intake",
        "retry_pending",
        "retry_success",
        "retry_failed",
        "abandoned"
      ],
      "default": "received_intake"
    },
    "intake_reason": {
      "type": "string"
    },
    "primary_failure_kind": {
      "type": "string"
    },
    "fallback_failure_kind": {
      "type": "string"
    },
    "primary_error_json": {
      "type": "string"
    },
    "fallback_error_json": {
      "type": "string"
    },
    "retry_error_json": {
      "type": "string"
    },
    "transformed_payload_json": {
      "type": "string"
    },
    "raw_responses_json": {
      "type": "string"
    },
    "diagnostics_json": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at_client": {
      "type": "string"
    },
    "created_at_server": {
      "type": "string"
    },
    "last_retry_at": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "linked_submission_id": {
      "type": "string"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Current AI repair lifecycle status (e.g. pending, running, completed, failed, skipped)"
    },
    "ai_repair_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of AI repair attempts made for this intake record"
    },
    "last_ai_repair_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent AI repair attempt"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "Serialized error details if the AI repair attempt itself failed"
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "Full JSON report returned by the pro_submission_repair_agent (decision, diagnosis, changed_paths, warnings, etc.)"
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "Serialized repaired payload produced by the pro_submission_repair_agent"
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if the AI-repaired payload was accepted and used in a submission attempt"
    },
    "ai_repair_retry_attempted": {
      "type": "boolean",
      "default": false,
      "description": "True if a submission retry was attempted using the AI-repaired payload"
    },
    "ai_repair_retry_result_json": {
      "type": "string",
      "description": "Serialized result of the submission retry that used the AI-repaired payload"
    },
    "ai_repair_source": {
      "type": "string",
      "description": "Source context that triggered the AI repair (e.g. admin_manual, scheduled_job, retry_hook)"
    },
    "identity_resolution_status": {
      "type": "string",
      "description": "Latest identity-resolution state without changing the intake workflow status"
    },
    "identity_resolution_latest_attempt_id": {
      "type": "string",
      "description": "Latest ProFormIdentityResolutionAttempt record for this intake"
    },
    "identity_resolution_fingerprint": {
      "type": "string",
      "description": "Resolver-versioned fingerprint used for stale-write and duplicate-attempt protection"
    },
    "last_identity_resolution_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent non-diagnostic identity-resolution attempt"
    },
    "identity_resolution_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of non-diagnostic identity-resolution attempts"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this intake was moved out of the active recovery dataset"
    },
    "archive_reason": {
      "type": "string",
      "description": "Policy or administrator reason for archiving this intake"
    },
    "retention_policy_version": {
      "type": "string",
      "description": "Versioned retention policy applied to this intake"
    },
    "retention_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent meaningful activity used to calculate the minimum retention period"
    },
    "retention_until": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest date this record may leave the active recovery dataset"
    },
    "soft_deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator moved this intake to Deleted Records without erasing it"
    },
    "soft_deleted_by": {
      "type": "string",
      "description": "Audited administrator or recovery-grant actor that soft-deleted this intake"
    },
    "soft_delete_reason": {
      "type": "string",
      "description": "Administrator-supplied reason for soft deletion"
    },
    "retention_restore_source_id": {
      "type": "string",
      "description": "Original record ID when this intake was restored from an independent backup"
    }
  },
  "required": [
    "questionnaire_session_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}
