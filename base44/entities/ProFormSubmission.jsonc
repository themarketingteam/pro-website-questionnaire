{
  "name": "ProFormSubmission",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "business_name": {
          "type": "string",
          "description": "The business name"
        },
        "businessDomain": {
          "type": "string",
          "description": "The business domain"
        },
        "submission_datetime": {
          "type": "string",
          "format": "date-time",
          "description": "When the form was submitted"
        },
        "service_type": {
          "type": "string",
          "default": "pro",
          "description": "The service tier (pro, essentials, etc.)"
        },
        "questionnaire_session_id": {
          "type": "string",
          "description": "Stable non-sensitive session ID of the source questionnaire draft"
        },
        "source_draft_id": {
          "type": "string",
          "description": "Server-side ProFormDraft record linked to this submission"
        },
        "source_intake_id": {
          "type": "string",
          "description": "Server-side fallback intake linked to this submission"
        },
        "submission_attempt_id": {
          "type": "string",
          "description": "Stable idempotency key for this client submission attempt"
        },
        "submission_content_fingerprint": {
          "type": "string",
          "description": "Server-computed fingerprint of the source draft identity and submitted content"
        },
        "client_identity_fingerprint": {
          "type": "string",
          "description": "Server-computed fingerprint used to prevent cross-client submission reuse"
        },
        "questionnaire_payload_version": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "Absent or 1 is legacy; 2 means at least one question has an authoritative page-tree-v1 structure."
        }
      }
    },
    "userdata": {
      "type": "object",
      "properties": {
        "additional_pages_list": {
          "type": "object",
          "description": "Optional additional pages configuration",
          "properties": {
            "why_choose_us_page": {
              "type": "object",
              "properties": {
                "generate_page": {
                  "type": "boolean",
                  "description": "If true, generate a Why Choose Us page. Based on Q1."
                },
                "why_choose_us_description": {
                  "type": "string",
                  "description": "Q1.1: Description for the Why Choose Us page"
                }
              }
            },
            "meet_the_team_page": {
              "type": "object",
              "properties": {
                "generate_page": {
                  "type": "boolean",
                  "description": "If true, generate a Meet the Team page. Based on Q2."
                },
                "team_introduction": {
                  "type": "string",
                  "description": "Q2.1: Introduction text for the Meet the Team page"
                },
                "team_photo_with_tags": {
                  "type": "object",
                  "description": "Q2.2: Team photo and tagged team members",
                  "properties": {
                    "imageUrl": {
                      "type": "string",
                      "description": "URL of the team photo"
                    },
                    "taggedPeople": {
                      "type": "array",
                      "description": "Array of team members tagged in the photo",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Team member's name"
                          },
                          "position": {
                            "type": "string",
                            "description": "Team member's position/title"
                          },
                          "bio": {
                            "type": "string",
                            "description": "Team member's biography"
                          },
                          "x": {
                            "type": "number",
                            "description": "X coordinate of tag on image"
                          },
                          "y": {
                            "type": "number",
                            "description": "Y coordinate of tag on image"
                          },
                          "person": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "position": {
                                "type": "string"
                              },
                              "bio": {
                                "type": "string"
                              }
                            },
                            "description": "Normalized team-member details retained with the photo tag"
                          }
                        }
                      }
                    },
                    "imageName": {
                      "type": "string",
                      "description": "Original name of the selected team photo"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "fileName": {
                            "type": "string"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "size": {
                            "type": "number"
                          },
                          "mimeType": {
                            "type": "string"
                          },
                          "uploadedAt": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Additional team-photo labels"
                    },
                    "notes": {
                      "type": "string",
                      "description": "Client notes accompanying the team photo"
                    },
                    "has_team_photo": {
                      "type": "boolean",
                      "description": "Whether the client supplied or explicitly selected a team photo"
                    }
                  }
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Retained legacy additional-page list"
            }
          }
        },
        "service_offerings": {
          "type": "array",
          "description": "Q3: Selected service offerings from predefined list",
          "items": {
            "type": "string"
          }
        },
        "service_offerings_other": {
          "type": "string",
          "description": "Q3: Custom service offerings not in predefined list"
        },
        "target_industries": {
          "type": "array",
          "description": "Q4: Selected target industries from predefined list",
          "items": {
            "type": "string"
          }
        },
        "target_industries_other": {
          "type": "string",
          "description": "Q4: Custom target industries not in predefined list"
        },
        "geographic_areas": {
          "type": "array",
          "description": "Q5: Geographic areas served with location metadata",
          "items": {
            "type": "object",
            "properties": {
              "geographic_area_meta": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Location name"
                  },
                  "label": {
                    "type": "string",
                    "description": "Full location label"
                  },
                  "lat": {
                    "type": "string",
                    "description": "Latitude"
                  },
                  "lon": {
                    "type": "string",
                    "description": "Longitude"
                  },
                  "place_id": {
                    "type": "string",
                    "description": "Google Places ID"
                  },
                  "source": {
                    "type": "string",
                    "description": "Data source (e.g., 'google')"
                  },
                  "primary": {
                    "type": "boolean",
                    "description": "True if this is the primary service location"
                  }
                }
              }
            }
          }
        },
        "company_description": {
          "type": "string",
          "description": "Q6: Company description and history"
        },
        "delivery_model": {
          "type": "string",
          "description": "Q7: How services are delivered (on-site, remote, hybrid)"
        },
        "delivery_model_other": {
          "type": "string",
          "description": "Q7: Custom delivery model if 'Other' was selected"
        },
        "pricing_packaging": {
          "type": "array",
          "description": "Q8: Pricing and packaging models",
          "items": {
            "type": "string"
          }
        },
        "pricing_packaging_other": {
          "type": "string",
          "description": "Q8: Custom pricing model if 'Other' was selected"
        },
        "differentiation": {
          "type": "string",
          "description": "Q9: What makes the company different from competitors"
        },
        "company_goals": {
          "type": "array",
          "description": "Q10: Company goals for the website",
          "items": {
            "type": "string"
          }
        },
        "company_goals_other": {
          "type": "string",
          "description": "Q10: Custom goals not in predefined list"
        },
        "brand_tone": {
          "type": "string",
          "description": "Q11: Desired brand tone and voice"
        },
        "brand_tone_other": {
          "type": "string",
          "description": "Q11: Custom brand tone if 'Other' was selected"
        },
        "certifications_partnerships": {
          "type": "array",
          "description": "Q12.1: Certifications, awards, and partnerships (only if Q12 is yes)",
          "items": {
            "type": "object",
            "properties": {
              "cert_item_name": {
                "type": "string",
                "description": "Name of certification/partnership"
              },
              "cert_item_type": {
                "type": "string",
                "description": "Type: certification, accolade, award, or partnership"
              },
              "cert_item_image_url": {
                "type": "string",
                "description": "Badge or logo image URL"
              },
              "cert_item_file_url": {
                "type": "string",
                "description": "Supporting document URL"
              },
              "cert_item_image_name": {
                "type": "string",
                "description": "Original certification badge filename"
              },
              "cert_item_file_name": {
                "type": "string",
                "description": "Original supporting-document filename"
              },
              "cert_item_files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "size": {
                      "type": "number"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "uploadedAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "sales_process": {
          "type": "string",
          "description": "Q13: Sales process and client onboarding"
        },
        "service_guarantee": {
          "type": "boolean",
          "description": "Q14: If true, the company offers service guarantees/warranties/SLAs. If false, they do not."
        },
        "service_guarantee_items": {
          "type": "array",
          "description": "Q14.1: Service guarantees, warranties, and SLAs (only if service_guarantee is true)",
          "items": {
            "type": "object",
            "properties": {
              "guarantee_name": {
                "type": "string",
                "description": "Name of the guarantee"
              },
              "guarantee_type": {
                "type": "string",
                "description": "Type: warranty, guarantee, or sla"
              },
              "guarantee_file_url": {
                "type": "string",
                "description": "Supporting document URL"
              },
              "guarantee_description": {
                "type": "string",
                "description": "Description of the guarantee"
              },
              "guarantee_file_name": {
                "type": "string",
                "description": "Original supporting guarantee-document filename"
              }
            }
          }
        },
        "client_acquisition": {
          "type": "string",
          "description": "Q15: How the company currently acquires clients"
        },
        "client_acquisition_other": {
          "type": "string",
          "description": "Q15: Custom acquisition method if 'Other' was selected"
        },
        "website_objectives": {
          "type": "array",
          "description": "Q16: Primary objectives for the website",
          "items": {
            "type": "string"
          }
        },
        "website_objectives_other": {
          "type": "string",
          "description": "Q16: Custom objectives not in predefined list"
        },
        "client_size": {
          "type": "string",
          "description": "Q17: Typical client company size (e.g., '10-100 employees')"
        },
        "client_challenges": {
          "type": "array",
          "description": "Q18: Challenges that ideal clients face",
          "items": {
            "type": "string"
          }
        },
        "client_challenges_other": {
          "type": "string",
          "description": "Q18: Custom challenges not in predefined list"
        },
        "client_frustrations": {
          "type": "string",
          "description": "Q19: Client frustrations and pain points"
        },
        "client_outcomes": {
          "type": "array",
          "description": "Q20: Desired outcomes for clients",
          "items": {
            "type": "string"
          }
        },
        "client_outcomes_other": {
          "type": "string",
          "description": "Q20: Custom outcomes not in predefined list"
        },
        "value_description": {
          "type": "string",
          "description": "Q21: How the company delivers value to clients"
        },
        "ideal_client": {
          "type": "string",
          "description": "Q22: Description of the ideal client profile"
        },
        "avoided_clients": {
          "type": "string",
          "description": "Q23.1: Types of clients to avoid (only if Q23 is yes)"
        },
        "primary_cta": {
          "type": "string",
          "description": "Q24: Primary call-to-action for the website"
        },
        "primary_cta_other": {
          "type": "string",
          "description": "Q24: Custom CTA if 'Other' was selected"
        },
        "additional_notes": {
          "type": "string",
          "description": "Q25.1: Additional notes or instructions (only if Q25 is yes)"
        },
        "service_offerings_structure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "page-tree-v1"
              ]
            },
            "pages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "predefined",
                      "custom"
                    ]
                  },
                  "catalogId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2000
                  },
                  "children": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "predefined",
                            "custom"
                          ]
                        },
                        "catalogId": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 2000
                        },
                        "children": {
                          "type": "array",
                          "maxItems": 0,
                          "items": {
                            "type": "object"
                          }
                        }
                      },
                      "required": [
                        "label",
                        "source"
                      ]
                    }
                  }
                },
                "required": [
                  "label",
                  "source"
                ]
              }
            }
          },
          "required": [
            "format",
            "pages"
          ],
          "description": "Optional authoritative mapped page tree. Array position is sibling priority. New pages contain label and source, with children only for nonempty parents; optional historical id/catalogId and empty children remain readable."
        },
        "target_industries_structure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "page-tree-v1"
              ]
            },
            "pages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "predefined",
                      "custom"
                    ]
                  },
                  "catalogId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2000
                  },
                  "children": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "predefined",
                            "custom"
                          ]
                        },
                        "catalogId": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 2000
                        },
                        "children": {
                          "type": "array",
                          "maxItems": 0,
                          "items": {
                            "type": "object"
                          }
                        }
                      },
                      "required": [
                        "label",
                        "source"
                      ]
                    }
                  }
                },
                "required": [
                  "label",
                  "source"
                ]
              }
            }
          },
          "required": [
            "format",
            "pages"
          ],
          "description": "Optional authoritative mapped page tree. Array position is sibling priority. New pages contain label and source, with children only for nonempty parents; optional historical id/catalogId and empty children remain readable."
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Legacy industry selections retained by the browser submission normalizer"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Legacy location selections retained by the browser submission normalizer"
        },
        "team_photo_with_tags": {
          "type": "object",
          "description": "Compatibility copy of the team photo retained by the browser submission normalizer",
          "properties": {
            "imageUrl": {
              "type": "string",
              "description": "URL of the team photo"
            },
            "taggedPeople": {
              "type": "array",
              "description": "Array of team members tagged in the photo",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Team member's name"
                  },
                  "position": {
                    "type": "string",
                    "description": "Team member's position/title"
                  },
                  "bio": {
                    "type": "string",
                    "description": "Team member's biography"
                  },
                  "x": {
                    "type": "number",
                    "description": "X coordinate of tag on image"
                  },
                  "y": {
                    "type": "number",
                    "description": "Y coordinate of tag on image"
                  },
                  "person": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "position": {
                        "type": "string"
                      },
                      "bio": {
                        "type": "string"
                      }
                    },
                    "description": "Normalized team-member details retained with the photo tag"
                  }
                }
              }
            },
            "imageName": {
              "type": "string",
              "description": "Original name of the selected team photo"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "size": {
                    "type": "number"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "uploadedAt": {
                    "type": "string"
                  }
                }
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Additional team-photo labels"
            },
            "notes": {
              "type": "string",
              "description": "Client notes accompanying the team photo"
            },
            "has_team_photo": {
              "type": "boolean",
              "description": "Whether the client supplied or explicitly selected a team photo"
            }
          }
        },
        "service_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "county": {
                "type": "string"
              },
              "zip": {
                "type": "string"
              },
              "place_id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "radius": {
                "type": "number"
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          "description": "Legacy service areas retained with normalized location details"
        }
      }
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this final submission moved out of the active recovery dataset"
    },
    "archive_reason": {
      "type": "string",
      "description": "Policy or administrator reason for archiving this final submission"
    },
    "retention_policy_version": {
      "type": "string",
      "description": "Versioned retention policy applied to this final submission"
    },
    "retention_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent meaningful activity used to calculate the minimum retention period"
    },
    "retention_until": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest date this record may leave the active recovery dataset"
    },
    "soft_deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator moved this submission to Deleted Records without erasing it"
    },
    "soft_deleted_by": {
      "type": "string",
      "description": "Audited administrator or recovery-grant actor that soft-deleted this submission"
    },
    "soft_delete_reason": {
      "type": "string",
      "description": "Administrator-supplied reason for soft deletion"
    },
    "retention_restore_source_id": {
      "type": "string",
      "description": "Original record ID when this submission was reconstructed from an independent backup"
    },
    "automatic_retry_job_key": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_retry_raw_responses_json": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_retry_outbound_payload_json": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_delivery_status": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_delivery_accepted_at": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_delivery_key": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    },
    "automatic_delivery_started_at": {
      "type": "string",
      "description": "Server-only automatic submission delivery checkpoint."
    }
  },
  "required": [
    "metadata",
    "userdata"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}
