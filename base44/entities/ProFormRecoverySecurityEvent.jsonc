{
  "name": "ProFormRecoverySecurityEvent",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Opaque server-generated request identifier used to correlate one recovery security decision."
    },
    "environment": {
      "type": "string",
      "description": "Trusted backend environment classification for this security event."
    },
    "attempt_type": {
      "type": "string",
      "enum": ["email_recovery", "code_recovery", "list_choices", "select_choice", "captcha", "admin_review", "admin_password_authentication", "admin_grant_validation", "admin_grant_revocation", "admin_draft_list", "admin_draft_detail", "admin_draft_update", "admin_event_list", "admin_retry_submission", "admin_repair_submission", "admin_migration_analyze", "admin_migration_apply", "admin_migration_duplicate_resolution", "admin_migration_rollback", "admin_retention_analyze", "admin_retention_apply", "retention_dry_run", "retention_apply_start", "retention_draft_delete", "retention_event_delete", "retention_skip", "retention_manual_review", "retention_failure", "retention_completion"],
      "description": "Allowlisted recovery operation that produced this security event."
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "not_found", "invalid_input", "rate_limited", "captcha_required", "captcha_failed", "locked", "superseded", "internal_error", "authorized", "invalid_password", "invalid_grant", "grant_version_mismatch", "password_version_mismatch", "device_mismatch", "environment_mismatch", "revoked", "eligible", "protected", "manual_review", "deleted", "skipped", "failed", "completed", "dry_run_only"],
      "description": "Internal allowlisted outcome; public responses use a generic recovery-not-completed envelope."
    },
    "subject_hash": {
      "type": "string",
      "description": "Purpose-separated HMAC of the normalized email or recovery-code abuse subject."
    },
    "ip_hash": {
      "type": "string",
      "description": "Purpose-separated HMAC of trusted normalized network context or the stable unknown bucket."
    },
    "device_hash": {
      "type": "string",
      "description": "Purpose-separated HMAC of the random client device identifier, never a browser fingerprint."
    },
    "recovery_email_lookup_hash": {
      "type": "string",
      "description": "Optional authorized backend linkage to an existing recovery-email lookup hash.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "draft_id": {
      "type": "string",
      "description": "Optional authorized backend linkage to the affected draft.",
      "rls": {"read": {"user_condition": {"role": "admin"}}, "write": {"user_condition": {"role": "admin"}}}
    },
    "captcha_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether policy required CAPTCHA for this attempt."
    },
    "captcha_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether server-side CAPTCHA verification succeeded for this attempt."
    },
    "failure_count_window": {
      "type": "number",
      "description": "Bounded count of relevant failures in the active policy window."
    },
    "attempt_count_window": {
      "type": "number",
      "description": "Bounded count of relevant attempts in the active policy window."
    },
    "lockout_until": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp after which a temporary lockout may be reevaluated."
    },
    "window_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp at the start of the evaluated rate-limit window."
    },
    "created_at_server": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative server timestamp for this event."
    },
    "policy_version": {
      "type": "number",
      "description": "Recovery security policy version used for this decision."
    },
    "test_run_id": {
      "type": "string",
      "description": "Synthetic test-run identifier used to isolate and clean nonproduction evidence."
    },
    "source_app_id": {
      "type": "string",
      "description": "Internal Base44 application identifier of the source event."
    },
    "source_entity": {
      "type": "string",
      "description": "Source entity name used in deterministic migration identity."
    },
    "source_record_id": {
      "type": "string",
      "description": "Source record identifier used in deterministic migration identity."
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp reported by the source platform."
    },
    "source_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "Update timestamp reported by the source platform."
    },
    "migration_batch_id": {
      "type": "string",
      "description": "Opaque identifier of the migration batch that wrote this representation."
    },
    "migration_direction": {
      "type": "string",
      "description": "Forward or reverse migration direction for this representation."
    },
    "migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative timestamp when the migration runner wrote this representation."
    },
    "source_content_hash": {
      "type": "string",
      "description": "Stable hash of migration-relevant source content excluding destination bookkeeping."
    },
    "migration_version": {
      "type": "number",
      "description": "Version of the migration transform applied to this representation."
    }
  },
  "required": ["request_id", "environment"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
