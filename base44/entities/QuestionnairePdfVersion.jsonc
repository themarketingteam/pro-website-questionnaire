{
  "type": "object",
  "name": "QuestionnairePdfVersion",
  "properties": {
    "source_type": {
      "type": "string",
      "description": "Record type used to generate this PDF",
      "enum": [
        "draft",
        "intake",
        "submission"
      ]
    },
    "source_id": {
      "type": "string",
      "description": "ID of the draft, intake, or final submission"
    },
    "session_id": {
      "type": "string",
      "description": "Questionnaire session identifier when available"
    },
    "payload_hash": {
      "type": "string",
      "description": "SHA-256 fingerprint of the values rendered into this PDF"
    },
    "file_url": {
      "type": "string",
      "description": "Saved Base44 public-storage URL for the generated PDF",
      "format": "uri"
    },
    "file_name": {
      "type": "string",
      "description": "Download filename for the generated PDF"
    },
    "version_number": {
      "type": "integer",
      "description": "Monotonically increasing version number within the source record",
      "minimum": 1
    },
    "business_name": {
      "type": "string",
      "description": "Business name shown in the PDF"
    },
    "domain": {
      "type": "string",
      "description": "Business domain shown in the PDF"
    },
    "generated_at": {
      "type": "string",
      "description": "When this PDF version was generated",
      "format": "date-time"
    }
  },
  "required": [
    "source_type",
    "source_id",
    "payload_hash",
    "file_url",
    "file_name",
    "version_number",
    "generated_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}
