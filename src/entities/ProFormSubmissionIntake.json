{
  "name": "ProFormSubmissionIntake",
  "type": "object",
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "business_name": {
      "type": "string",
      "description": "Business name from the submission or draft"
    },
    "business_domain": {
      "type": "string",
      "description": "Business domain from the submission or draft"
    },
    "user_email": {
      "type": "string",
      "description": "User email if available"
    },
    "user_id": {
      "type": "string",
      "description": "User id if available"
    },
    "status": {
      "type": "string",
      "enum": ["submitted", "received_intake", "retry_pending", "retry_success", "retry_failed", "abandoned"],
      "default": "received_intake",
      "description": "Lifecycle state for the recovery intake"
    },
    "intake_reason": {
      "type": "string",
      "description": "Why the intake record was created or updated"
    },
    "primary_failure_kind": {
      "type": "string",
      "description": "Classified browser-side primary failure kind"
    },
    "fallback_failure_kind": {
      "type": "string",
      "description": "Classified fallback failure kind when applicable"
    },
    "primary_error_json": {
      "type": "string",
      "description": "Serialized primary error details"
    },
    "fallback_error_json": {
      "type": "string",
      "description": "Serialized fallback error details"
    },
    "retry_error_json": {
      "type": "string",
      "description": "Serialized retry error details"
    },
    "transformed_payload_json": {
      "type": "string",
      "description": "Serialized transformed payload used for retry or recovery"
    },
    "raw_responses_json": {
      "type": "string",
      "description": "Serialized raw questionnaire responses when available"
    },
    "diagnostics_json": {
      "type": "string",
      "description": "Serialized safe diagnostics for support"
    },
    "source": {
      "type": "string",
      "description": "Origin of the intake write"
    },
    "created_at_client": {
      "type": "string",
      "description": "Client-side timestamp when submit/fallback was triggered"
    },
    "created_at_server": {
      "type": "string",
      "description": "Server-side timestamp when intake record was written"
    },
    "last_retry_at": {
      "type": "string",
      "description": "Last retry timestamp"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "How many times retry/update logic has touched this record"
    },
    "linked_submission_id": {
      "type": "string",
      "description": "Linked ProFormSubmission id when available"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether Zapier was notified"
    },
    "notes": {
      "type": "string",
      "description": "Support/admin notes"
    }
  },
  "required": ["questionnaire_session_id"]
}